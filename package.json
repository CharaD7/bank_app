{
  "name": "ahantaman-rural-bank",
  "main": "expo-router/entry",
  "version": "1.0.0",
  "scripts": {
    "start": "expo start",
    "reset-project": "node ./scripts/reset-project.js",
    "check-config": "node ./scripts/check-config.js",
    "debug-startup": "node ./scripts/debug-startup.js",
    "biometric:verify": "node ./scripts/verify-biometric-collections.js",
    "biometric:debug": "node ./scripts/debug-biometric-verify.js",
    "biometric:test": "node ./scripts/test-biometric-service.js",
    "biometric:integration": "node ./scripts/test-biometric-integration.js",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "lint": "expo lint",
    "env:print": "node -e \"console.log({\n  APPWRITE_URL: process.env.EXPO_PUBLIC_APPWRITE_URL,\n  APPWRITE_PROJECT_ID: process.env.EXPO_PUBLIC_APPWRITE_PROJECT_ID,\n  APPWRITE_DATABASE_ID: process.env.EXPO_PUBLIC_APPWRITE_DATABASE_ID\n});\"",
    "build:dev:fast": "NODE_ENV=development EXPO_USE_FAST_RESOLVER=1 expo export --platform web",
    "build:production:fast": "NODE_ENV=production EXPO_USE_FAST_RESOLVER=1 eas build --platform all --non-interactive",
    "build:android:fast": "NODE_ENV=development EXPO_USE_FAST_RESOLVER=1 eas build --platform android --non-interactive",
    "build:ios:fast": "NODE_ENV=development EXPO_USE_FAST_RESOLVER=1 eas build --platform ios --non-interactive",
    "prebuild:fast": "NODE_ENV=development expo prebuild --clean",
    "optimize:assets": "node scripts/optimize-build.js",
    "cache:clear": "rm -rf .metro-cache node_modules/.cache .expo && bun install",
    "cache:clear:all": "rm -rf .metro-cache node_modules/.cache .expo node_modules && bun install",
    "benchmark": "node scripts/benchmark-build.js",
    "benchmark:quick": "node scripts/benchmark-build.js --quick",
    "validate": "node scripts/validate-optimizations.js"
  },
  "dependencies": {
    "@expo/vector-icons": "^15.0.2",
    "@react-native-async-storage/async-storage": "^2.2.0",
    "@react-navigation/bottom-tabs": "^7.3.10",
    "@react-navigation/elements": "^2.6.3",
    "@react-navigation/native": "^7.1.6",
    "appwrite": "^20.1.0",
    "clsx": "^2.1.1",
    "expo": "~54.0.11",
    "expo-blur": "^15.0.7",
    "expo-constants": "~18.0.9",
    "expo-dev-client": "^6.0.12",
    "expo-device": "~8.0.9",
    "expo-document-picker": "^14.0.7",
    "expo-file-system": "~19.0.16",
    "expo-font": "~14.0.8",
    "expo-haptics": "^15.0.7",
    "expo-image": "~3.0.8",
    "expo-image-manipulator": "~14.0.7",
    "expo-image-picker": "~17.0.8",
    "expo-linear-gradient": "^15.0.7",
    "expo-linking": "~8.0.8",
    "expo-local-authentication": "^17.0.7",
    "expo-media-library": "^18.2.0",
    "expo-navigation-bar": "~5.0.8",
    "expo-network": "^8.0.7",
    "expo-print": "^15.0.7",
    "expo-router": "~6.0.9",
    "expo-secure-store": "^15.0.7",
    "expo-sharing": "~14.0.7",
    "expo-splash-screen": "~31.0.10",
    "expo-status-bar": "~3.0.8",
    "expo-symbols": "~1.0.7",
    "expo-system-ui": "~6.0.7",
    "expo-updates": "~29.0.12",
    "expo-web-browser": "~15.0.8",
    "libphonenumber-js": "^1.12.13",
    "lucide-react-native": "^0.544.0",
    "nativewind": "^4.1.23",
    "pdfkit": "^0.17.2",
    "puppeteer": "^24.23.0",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-native": "0.81.4",
    "react-native-chart-kit": "^6.12.0",
    "react-native-gesture-handler": "~2.28.0",
    "react-native-reanimated": "~4.1.1",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-screens": "~4.16.0",
    "react-native-svg": "15.12.1",
    "react-native-url-polyfill": "^2.0.0",
    "react-native-vector-icons": "^10.3.0",
    "react-native-web": "^0.21.0",
    "react-native-webview": "^13.16.0",
    "tailwindcss": "^3.4.17",
    "zustand": "^5.0.8"
  },
  "devDependencies": {
    "@babel/core": "^7.28.3",
    "@babel/plugin-proposal-decorators": "^7.28.0",
    "@babel/plugin-transform-flow-strip-types": "^7.27.1",
    "@types/react": "~19.1.10",
    "@types/react-native": "^0.73.0",
    "babel-plugin-module-resolver": "^5.0.2",
    "babel-plugin-transform-remove-console": "^6.9.4",
    "dotenv": "^17.2.1",
    "eslint": "^9.34.0",
    "eslint-config-expo": "~10.0.0",
    "react-refresh": "^0.18.0",
    "typescript": "~5.9.2"
  },
  "private": true,
  "resolutions": {
    "react-native-svg": "15.12.1",
    "react-native-reanimated": "~4.1.1"
  }
}
